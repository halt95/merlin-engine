+// ---------------------------------------------------------------------------------------------
+// sm8x tile: opt-in small-q FP8 verify layout experiment (v4).
+//
+// Mode comes from FLASHINFER_SM8X_FP8_SMALLQ and is FROZEN for the process: it is read on the
+// first plan and every later plan re-reads it and raises if it changed, so a plan cache or a
+// captured CUDA graph can never mix arms within one process. Values: unset/"0" (stock), "cta32",
+// "cta16". The experiment applies only to a plan that is exactly the 27B verify shape:
+//   uniform_q_len in {4, 5} (uniform multi-token decode plan: the tensor-core decode wrapper with
+//   q_len_per_req == 4 or 5, i.e. MTP K = 3 or 4), GQA group == 6, KV dtype tag == E4M3 (passed by
+//   the typed plan entry point; E5M2, NVFP4 and 16-bit KV carry the "other" tag),
+//   head_dim_qk == head_dim_vo == 256, device compute capability exactly 8.6, and every request's
+//   packed length == 6 * uniform_q_len (24 or 30 rows, both <= CTA_TILE_Q 32).
+// "cta16" (the discriminator arm) applies to uniform_q_len == 4 only.
+// Any other plan keeps the stock heuristic and the stock work order, whatever the mode.
+// The first plan that applies the override prints one proof line per (mode, q_len) per loaded
+// module to stderr, e.g. "[flashinfer-sm8x-tile] smallq=cta32 q_len=5 rows=30 cta_tile_q=32 device=0",
+// where device is the planning thread's current CUDA device (cudaGetDevice, i.e. relative to
+// CUDA_VISIBLE_DEVICES). It is printed when the PLAN takes the tile, before any kernel runs: it
+// proves the planner's choice on that device, not a successful execution. Stock mode never prints.
+// ---------------------------------------------------------------------------------------------
+constexpr uint32_t kSm8xKVTagOther = 0;
+constexpr uint32_t kSm8xKVTagE4M3 = 1;
+
+enum class Sm8xSmallQMode : int { kStock = 0, kCta32 = 1, kCta16 = 2 };
+
+inline Sm8xSmallQMode Sm8xParseSmallQMode() {
+  const char* v = std::getenv("FLASHINFER_SM8X_FP8_SMALLQ");
+  if (v == nullptr || v[0] == 0 || std::strcmp(v, "0") == 0) return Sm8xSmallQMode::kStock;
+  if (std::strcmp(v, "cta32") == 0) return Sm8xSmallQMode::kCta32;
+  if (std::strcmp(v, "cta16") == 0) return Sm8xSmallQMode::kCta16;
+  std::ostringstream err_msg;
+  err_msg << "FLASHINFER_SM8X_FP8_SMALLQ=" << v << " is not one of 0, cta32, cta16";
+  FLASHINFER_ERROR(err_msg.str());
+  return Sm8xSmallQMode::kStock;
+}
+
+// Process-frozen mode (first read wins; a later change is an error, not a silent switch).
+inline Sm8xSmallQMode Sm8xFrozenSmallQMode() {
+  static const Sm8xSmallQMode frozen = Sm8xParseSmallQMode();
+  const Sm8xSmallQMode now = Sm8xParseSmallQMode();
+  if (now != frozen) {
+    FLASHINFER_ERROR(
+        "FLASHINFER_SM8X_FP8_SMALLQ changed after the first plan in this process; the mode is "
+        "frozen per process (plan caches and captured graphs depend on it). Restart the process.");
+  }
+  return frozen;
+}
+
+/*!
+ * Resolve the experiment mode for ONE plan. Returns kStock unless the plan is the exact verify
+ * shape described above. Called once per PrefillSplitQOKVIndptr; the tile override and the
+ * cta16 work order both use this single result.
+ */
+inline Sm8xSmallQMode Sm8xResolveSmallQMode(const std::vector<int64_t>& packed_qo_len_arr,
+                                                  int64_t uniform_q_len, uint32_t num_qo_heads,
+                                                  uint32_t num_kv_heads, uint32_t head_dim_vo,
+                                                  uint32_t head_dim_qk, uint32_t kv_dtype_tag) {
+  const Sm8xSmallQMode mode = Sm8xFrozenSmallQMode();
+  if (mode == Sm8xSmallQMode::kStock) return mode;
+  const uint32_t qk = head_dim_qk ? head_dim_qk : head_dim_vo;
+  if ((uniform_q_len != 4 && uniform_q_len != 5) || num_kv_heads == 0 ||
+      num_qo_heads != 6 * num_kv_heads || kv_dtype_tag != kSm8xKVTagE4M3 || head_dim_vo != 256 ||
+      qk != 256) {
+    return Sm8xSmallQMode::kStock;
+  }
+  // cta16 (two 16-row q tiles) is a q_len-4 discriminator only.
+  if (mode == Sm8xSmallQMode::kCta16 && uniform_q_len != 4) return Sm8xSmallQMode::kStock;
+  const auto cc = GetCudaComputeCapability();
+  if (cc.first != 8 || cc.second != 6) return Sm8xSmallQMode::kStock;
+  // The uniform promise must hold for every request (the CUDA-graph branch also checks it;
+  // the eager branch otherwise only sees an average packed length).
+  const int64_t rows = 6 * uniform_q_len;
+  for (size_t i = 0; i < packed_qo_len_arr.size(); ++i) {
+    if (packed_qo_len_arr[i] != rows) {
+      std::ostringstream err_msg;
+      err_msg << "FLASHINFER_SM8X_FP8_SMALLQ experiment: request " << i << " has packed qo length "
+              << packed_qo_len_arr[i] << " but uniform_q_len=" << uniform_q_len
+              << " x GQA 6 promises " << rows;
+      FLASHINFER_ERROR(err_msg.str());
+    }
+  }
+  return mode;
+}
+
+/*!
+ * Apply a resolved experiment mode to the stock tile choice and, the first time a given
+ * (mode, q_len) is applied in this loaded module, print one proof line to stderr so a serving
+ * log can show which kernel path the plan took and on which CUDA device (the planning thread's
+ * current device; -1 if it cannot be read). Only reached for a non-stock resolved mode, so the
+ * knob-off path prints nothing. Planning-time evidence: the line does not prove the kernel ran.
+ */
+inline uint32_t Sm8xApplySmallQ(Sm8xSmallQMode mode, uint32_t cta_tile_q,
+                                   int64_t uniform_q_len) {
+  if (mode == Sm8xSmallQMode::kStock || cta_tile_q != 64) return cta_tile_q;
+  const uint32_t tile = (mode == Sm8xSmallQMode::kCta32) ? 32u : 16u;
+  static std::atomic<bool> announced[3][2];  // [mode][q_len 4, 5]; static storage: all false
+  const int mi = static_cast<int>(mode);
+  const int qi = (uniform_q_len == 5) ? 1 : 0;
+  bool expected = false;
+  if (announced[mi][qi].compare_exchange_strong(expected, true)) {
+    int device = -1;
+    if (cudaGetDevice(&device) != cudaSuccess) device = -1;
+    std::fprintf(stderr,
+                 "[flashinfer-sm8x-tile] smallq=%s q_len=%lld rows=%lld cta_tile_q=%u device=%d\n",
+                 mode == Sm8xSmallQMode::kCta32 ? "cta32" : "cta16",
+                 static_cast<long long>(uniform_q_len), static_cast<long long>(6 * uniform_q_len),
+                 tile, device);
+    std::fflush(stderr);
+  }
+  return tile;
+}

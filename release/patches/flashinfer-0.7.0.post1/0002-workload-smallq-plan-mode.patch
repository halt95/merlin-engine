+++ b/prefill.py
@@ -525,4 +525,22 @@
 
 
+# merlin-hook: workload-verify-tile
+def _sm8x_smallq_plan_adapter(func, arity):
+    if func is None:
+        return None
+
+    def call(*args, sm8x_smallq_mode=-1):
+        if type(sm8x_smallq_mode) is not int or sm8x_smallq_mode not in (-1, 0, 1):
+            raise ValueError("sm8x_smallq_mode must be -1, 0, or 1")
+        # 0.7.0.post1 FA2 has 20 plan / 18 workspace arguments before this patch.
+        if len(args) == arity:
+            return func(*args, sm8x_smallq_mode)
+        if sm8x_smallq_mode != -1:
+            raise ValueError("explicit small-q mode requires the FA2 planner")
+        return func(*args)
+
+    return call
+
+
 @functools.cache
 def get_batch_prefill_module(backend, *args):
